{
  "name": "smart4qube",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "test": "npm run test:api && npm run test:web",
    "issues:list": "bash scripts/list-issues.sh",
    "issues:add": "bash scripts/add-issue.sh",
    "issues:update": "bash scripts/update-issue.sh",
    "issues:remove": "bash scripts/remove-issue.sh"
  }
}
